t="0" lvl="0" marL="0" marR="0" rtl="0" algn="ctr"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr b="1" lang="en-CH" sz="1800"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/><a:sym typeface="Arial"/></a:rPr><a:t>Back</a:t></a:r><a:endParaRPr/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="157" name="Google Shape;157;p4"/><p:cNvSpPr txBox="1"/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="393700" y="1470995"/><a:ext cx="5975570" cy="4593424"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:schemeClr val="lt1"><a:alpha val="80000"/></a:schemeClr></a:solidFill><a:ln><a:noFill/></a:ln></p:spPr><p:txBody><a:bodyPr anchorCtr="0" anchor="t" bIns="45700" lIns="216000" spcFirstLastPara="1" rIns="216000" wrap="square" tIns="108000"><a:spAutoFit/></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="457200" lvl="0" marL="0" marR="0" rtl="0" algn="just"><a:spcBef><a:spcPts val="0"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-CH" sz="1800"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/><a:sym typeface="Arial"/></a:rPr><a:t>The Lausanne Cathedral is built from a variety of stones originating from different quarries all around Switzerland and some parts of Germany. </a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="457200" lvl="0" marL="0" marR="0" rtl="0" algn="just"><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-CH" sz="1800"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/><a:sym typeface="Arial"/></a:rPr><a:t>During the 19th century, the regional molasse sandstone of exposed architectural elements of the Cathedral was replaced with limestones and “harder” sandstones from the wider region of the canton Vaud. </a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="457200" lvl="0" marL="0" marR="0" rtl="0" algn="just"><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-CH" sz="1800"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/><a:sym typeface="Arial"/></a:rPr><a:t>In the 20th century, due to the scarcity of regional quarries, the general substitution of local molasse sandstone for maintenance and restoration became common practice. A variety of replacement sandstones from Fribourg, Bern, Zug, and Hannover (Oberkirchen, Germany) were utilized in its place </a:t></a:r><a:endParaRPr/></a:p><a:p><a:pPr indent="457200" lvl="0" marL="0" marR="0" rtl="0" algn="just"><a:lnSpc><a:spcPct val="150000"/></a:lnSpc><a:spcBef><a:spcPts val="1200"/></a:spcBef><a:spcAft><a:spcPts val="0"/></a:spcAft><a:buNone/></a:pPr><a:r><a:rPr lang="en-CH" sz="1800"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/><a:sym typeface="Arial"/></a:rPr><a:t>&lt; GO TO INTERACTIVE LEARNING &gt;</a:t></a:r><a:endParaRPr sz="1800"><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:latin typeface="Arial"/><a:ea typeface="Arial"/><a:cs typeface="Arial"/><a:sym typeface="Arial"/></a:endParaRPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="158" name="Google Shape;158;p4"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="10677416" y="187012"/><a:ext cx="1325695" cy="549800"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:schemeClr val="dk1"/></a:solidFill><a:ln cap="flat" cmpd="sng" w="19050"><a:solidFill><a:srgbClr val="082836"/></a:solidFill><a:prstDash val="solid"/><a:miter lim="800000"/><a:headEnd len="sm" w="sm" type="none"/><a:tailEnd len="sm" w="sm" type="none"/></a:ln></p:spPr